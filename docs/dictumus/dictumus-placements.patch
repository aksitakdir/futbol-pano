+import Link from "next/link";
+import { DICTUMUS_MIN_AGE, dictumusCardFor, dictumusPlayStoreUrl, dictumusWebAppUrl } from "@/lib/dictumus";
+
+/**
+ * The Dictumus card at the end of an article (lib/dictumus.ts decides where it shows).
+ * Hook-free like MoreInSection, so it renders into the article's HTML even inside the
+ * client article layouts. data-promo marks it for scripts and for anyone auditing
+ * how many promos a page carries (the rule is one).
+ */
+export default function DictumusCard({ category, slug, accent }: { category: string; slug: string; accent: string }) {
+  const card = dictumusCardFor(category, slug);
+  if (!card) return null;
+  return (
+    <aside
+      aria-label="Dictumus, a score-prediction game from the makers of Scout Gamer"
+      data-promo="dictumus"
+      style={{
+        marginTop: 56,
+        padding: "28px 28px 24px",
+        background: "var(--sg-surface)",
+        border: "1px solid var(--sg-border)",
+        borderLeft: `3px solid ${accent}`,
+        borderRadius: 6,
+      }}
+    >
+      <div className="mono" style={{ fontSize: 10, letterSpacing: "0.2em", color: accent, marginBottom: 12 }}>
+        FROM THE MAKERS OF SCOUT GAMER
+      </div>
+      <p className="display" style={{ fontSize: 22, fontWeight: 700, letterSpacing: "-0.02em", lineHeight: 1.2, color: "var(--sg-text-primary)", margin: "0 0 10px" }}>
+        {card.title}
+      </p>
+      <p style={{ fontSize: 15, lineHeight: 1.6, color: "var(--sg-text-secondary)", margin: "0 0 20px", maxWidth: 620 }}>
+        {card.body}
+      </p>
+      <div style={{ display: "flex", flexWrap: "wrap", gap: 10, alignItems: "center" }}>
+        <a
+          href={dictumusWebAppUrl(card.placement)}
+          target="_blank"
+          rel="noopener"
+          className="btn btn-solid"
+          style={{ background: accent, borderColor: accent, fontSize: 10 }}
+        >
+          PLAY DICTUMUS IN YOUR BROWSER
+        </a>
+        <a href={dictumusPlayStoreUrl(card.placement)} target="_blank" rel="noopener" className="btn" style={{ fontSize: 10 }}>
+          GET IT ON GOOGLE PLAY
+        </a>
+        <Link href="/dictumus" className="mono u-link" style={{ fontSize: 10, letterSpacing: "0.14em", color: "var(--sg-text-muted)", marginLeft: 4 }}>
+          HOW IT WORKS →
+        </Link>
+      </div>
+      <p className="mono" style={{ fontSize: 10, letterSpacing: "0.12em", color: "var(--sg-text-muted)", margin: "18px 0 0" }}>
+        AGES {DICTUMUS_MIN_AGE}+ · NO BETTING · NO MONEY BETWEEN PLAYERS · FREE UNTIL MID-SEASON
+      </p>
+    </aside>
+  );
+}
